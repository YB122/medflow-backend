# Copy to .env
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/medflow

# JWT — generate strong secrets for prod: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Redis (rate limit + OTP + refresh allowlist)
REDIS_URL=redis://localhost:6379

# RabbitMQ (appointment events; optional — falls back to in-memory)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Email (optional — logs to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@medflow.local

# Reminders (set to 1 to disable the 10-min reminder sweep)
DISABLE_REMINDERS=

# Cloudinary (doctor profile photos) — fill from your Cloudinary dashboard, never commit real values
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed
SEED_ADMIN_EMAIL=admin@medflow.local
SEED_ADMIN_PASSWORD=Admin123!

# CORS
CORS_ORIGIN=http://localhost:3001
