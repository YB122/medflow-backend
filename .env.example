# Copy to .env
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/medflow

# JWT — generate strong secrets for prod: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Redis (rate limit + OTP + refresh allowlist)
REDIS_URL=redis://localhost:6379



# Reminders (set to 1 to disable the 10-min reminder sweep)
DISABLE_REMINDERS=

# Cloudinary (doctor profile photos) — fill from your Cloudinary dashboard, never commit real values
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed
SEED_ADMIN_EMAIL=admin@medflow.local
SEED_ADMIN_PASSWORD=Admin123!

# CORS (comma-separated; local dev + production frontend)
CORS_ORIGIN=http://localhost:3001,https://medflow-front-end.vercel.app
